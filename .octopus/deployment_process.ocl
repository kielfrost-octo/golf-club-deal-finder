step "deploy-worker" {
    condition = "Variable"
    name = "Deploy Worker"
    properties = {
        Octopus.Step.ConditionVariableExpression = "#{if Octopus.Environment.Name == \"Production\"}True#{/if}"
    }

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.Script.ScriptBody = <<-EOT
                set -euo pipefail

                NODE_VERSION=22.11.0
                if ! command -v node >/dev/null; then
                  curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" | tar -xJ -C /tmp
                  export PATH="/tmp/node-v${NODE_VERSION}-linux-x64/bin:$PATH"
                fi

                cd "$(get_octopusvariable "Octopus.Action.Package[site].ExtractedPath")/worker"
                npm ci --no-audit --no-fund

                export CLOUDFLARE_API_TOKEN="$(get_octopusvariable "Cloudflare.ApiToken")"
                export CLOUDFLARE_ACCOUNT_ID="$(get_octopusvariable "Cloudflare.AccountId")"

                npx wrangler deploy \
                  --var "ALLOWED_ORIGINS:$(get_octopusvariable "Site.AllowedOrigins")" \
                  --var "EBAY_ENV:$(get_octopusvariable "eBay.Env")"

                printf '%s' "$(get_octopusvariable "eBay.ClientId")" | npx wrangler secret put EBAY_CLIENT_ID
                printf '%s' "$(get_octopusvariable "eBay.ClientSecret")" | npx wrangler secret put EBAY_CLIENT_SECRET
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
        worker_pool = "hosted-ubuntu"

        packages "site" {
            acquisition_location = "ExecutionTarget"
            feed = "octopus-server-built-in"
            package_id = "golf-club-deal-finder"
            properties = {
                Extract = "True"
                Purpose = ""
                SelectionMode = "immediate"
            }
        }
    }
}

step "publish-site" {
    name = "Publish Site to GitHub Pages"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.Script.ScriptBody = <<-EOT
                set -euo pipefail

                SRC="$(get_octopusvariable "Octopus.Action.Package[site].ExtractedPath")"
                OUT="$(mktemp -d)"
                cp "$SRC"/index.html "$SRC"/styles.css "$SRC"/app.js "$SRC"/api.js "$SRC"/render.js "$SRC"/flags.js "$OUT"/

                cat > "$OUT/config.js" <<CONFIG
                export const WORKER_URL = '$(get_octopusvariable "Worker.Url")';
                export const FEATURE_CLIENT_ID = '$(get_octopusvariable "Octopus.FeatureToggles.ClientIdentifier")';
                export const RELEASE_VERSION = '$(get_octopusvariable "Octopus.Release.Number")';
                export const ENVIRONMENT = '$(get_octopusvariable "Octopus.Environment.Name")';
                CONFIG
                VER="$(get_octopusvariable "Octopus.Release.Number")"
                sed -i -E "s#(from '\./[a-z]+\.js)'#\1?v=${VER}'#g" "$OUT"/*.js
                sed -i -E "s#(src|href)=\"(app\.js|styles\.css)\"#\1=\"\2?v=${VER}\"#g" "$OUT/index.html"
                touch "$OUT/.nojekyll"

                ENV_NAME="$(get_octopusvariable "Octopus.Environment.Name")"
                REPO="https://x-access-token:$(get_octopusvariable "GitHub.PagesToken")@github.com/kielfrost-octo/golf-club-deal-finder.git"
                SITE="$(mktemp -d)"
                git clone -q --depth 1 --branch gh-pages "$REPO" "$SITE"
                cd "$SITE"

                # Production owns the site root; each preview owns previews/<env>/.
                if [ "$ENV_NAME" = "Production" ]; then
                  find . -mindepth 1 -maxdepth 1 ! -name .git ! -name previews -exec rm -rf {} +
                  cp -R "$OUT"/. .
                  URL="https://kielfrost-octo.github.io/golf-club-deal-finder/"
                else
                  rm -rf "previews/${ENV_NAME}"
                  mkdir -p "previews/${ENV_NAME}"
                  cp -R "$OUT"/. "previews/${ENV_NAME}/"
                  touch .nojekyll
                  URL="https://kielfrost-octo.github.io/golf-club-deal-finder/previews/${ENV_NAME}/"
                fi

                git config user.name "Octopus Deploy"
                git config user.email "octopus@users.noreply.github.com"
                git add -A
                if git commit -q -m "Release #{Octopus.Release.Number} to ${ENV_NAME}"; then
                  for attempt in 1 2 3; do
                    git push -q origin gh-pages && break
                    [ "$attempt" = 3 ] && exit 1
                    git pull -q --rebase origin gh-pages
                  done
                fi

                set_octopusvariable "SiteUrl" "$URL"
                echo "Published to $URL"
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
        worker_pool = "hosted-ubuntu"

        packages "site" {
            acquisition_location = "ExecutionTarget"
            feed = "octopus-server-built-in"
            package_id = "golf-club-deal-finder"
            properties = {
                Extract = "True"
                Purpose = ""
                SelectionMode = "immediate"
            }
        }
    }
}
